{
  "name": "@papillonbits/setup",
  "version": "1.14.1",
  "description": "Papillon Bits Setup",
  "homepage": "https://github.com/papillonbits/papillonbits/tree/master/packages/setup",
  "repository": {
    "type": "git",
    "url": "https://github.com/papillonbits/papillonbits.git",
    "directory": "packages/setup"
  },
  "main": "build/index.js",
  "module": "src/index.js",
  "files": [
    "babel/",
    "eslint/",
    "jest/",
    "prettier/",
    "storybook/",
    "stylelint/",
    "webpack/",
    "README.md"
  ],
  "exports": {
    "./babel": "./babel/index.js",
    "./eslint": "./eslint/index.mjs",
    "./jest": "./jest/index.js",
    "./prettier": "./prettier/index.js",
    "./storybook": "./storybook/index.js",
    "./storybook/mainSetup": "./storybook/mainSetup.js",
    "./storybook/managerSetup": "./storybook/managerSetup.js",
    "./storybook/previewSetup": "./storybook/previewSetup.js",
    "./stylelint": "./stylelint/index.js",
    "./webpack": "./webpack/index.js"
  },
  "scripts": {
    "clean-up": "rm -rf build node_modules package-lock.json",
    "install-packages": "npm i",
    "install-papillonbits-latest": "echo \"setup skipping install-papillonbits-latest\" && exit 0",
    "build": "rm -rf build && babel --copy-files --no-copy-ignored --out-dir build src --ignore **/__tests__",
    "build-test": "npm run build",
    "build-acceptance": "npm run build",
    "build-release": "npm run build"
  }
}
