{
  "name": "@papillonbits/css",
  "version": "1.14.0",
  "description": "Papillon Bits CSS",
  "homepage": "https://github.com/papillonbits/papillonbits/tree/master/packages/css",
  "repository": {
    "type": "git",
    "url": "https://github.com/papillonbits/papillonbits.git",
    "directory": "packages/css"
  },
  "main": "build/index.scss",
  "module": "src/index.js",
  "files": [
    "build",
    "README.md"
  ],
  "exports": {
    "./index.scss": "./src/index.scss",
    "./support/mixins/color-modes.scss": "./src/primer/support/mixins/color-modes.scss",
    "./support/mixins/layout.scss": "./src/primer/support/mixins/layout.scss",
    "./support/mixins/misc.scss": "./src/primer/support/mixins/misc.scss",
    "./support/mixins/typography.scss": "./src/primer/support/mixins/typography.scss",
    "./support/variables/layout.scss": "./src/primer/support/variables/layout.scss",
    "./support/variables/misc.scss": "./src/primer/support/variables/misc.scss",
    "./support/variables/typography.scss": "./src/primer/support/variables/typography.scss",
    "./truncate/index.scss": "./src/primer/truncate/index.scss",
    "./utilities/animations.scss": "./src/primer/utilities/animations.scss",
    "./utilities/borders.scss": "./src/primer/utilities/borders.scss",
    "./utilities/box-shadow.scss": "./src/primer/utilities/box-shadow.scss",
    "./utilities/colors.scss": "./src/primer/utilities/colors.scss",
    "./utilities/details.scss": "./src/primer/utilities/details.scss",
    "./utilities/flexbox.scss": "./src/primer/utilities/flexbox.scss",
    "./utilities/layout.scss": "./src/primer/utilities/layout.scss",
    "./utilities/margin.scss": "./src/primer/utilities/margin.scss",
    "./utilities/padding.scss": "./src/primer/utilities/padding.scss",
    "./utilities/typography.scss": "./src/primer/utilities/typography.scss",
    "./utilities/visibility-display.scss": "./src/primer/utilities/visibility-display.scss"
  },
  "scripts": {
    "clean-up": "rm -rf build node_modules package-lock.json",
    "install-packages": "npm i",
    "install-papillonbits-latest": "echo \"css skipping install-papillonbits-latest\" && exit 0",
    "build": "rm -rf build && babel --copy-files --no-copy-ignored --out-dir build src",
    "build-test": "npm run build",
    "build-acceptance": "npm run build",
    "build-release": "npm run build"
  }
}
